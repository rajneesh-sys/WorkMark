SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/workmark
COMPOSE_DB_URL=jdbc:postgresql://postgres:5432/workmark
DB_USERNAME=workmark_app
DB_PASSWORD=replace-with-a-private-application-password
# Local-only setting; the production Compose overlay enforces verify-full.
DB_SSL_MODE=disable
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_EXPIRATION_SECONDS=3600
SERVER_PORT=8080
POSTGRES_DB=workmark
POSTGRES_USER=workmark_db_admin
POSTGRES_PASSWORD=replace-with-a-private-database-admin-password
POSTGRES_PORT=5432
SUPER_ADMIN_BOOTSTRAP_ENABLED=false
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
ACCOUNT_ACTIVATION_TTL=PT24H
LOGIN_RATE_LIMIT_MAX_FAILURES=5
LOGIN_RATE_LIMIT_WINDOW=PT5M
LOGIN_RATE_LIMIT_BASE_BLOCK=PT30S
LOGIN_RATE_LIMIT_MAX_BLOCK=PT15M
LOGIN_RATE_LIMIT_MAX_TRACKED_KEYS=100000
SWAGGER_ENABLED=false
SWAGGER_PUBLIC=false
